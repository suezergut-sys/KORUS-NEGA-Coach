# Секретный ключ используется только серверным маршрутом и никогда не попадает в браузер.
OPENAI_API_KEY=sk-proj-...

# Подключим на следующем этапе, после создания проекта Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
METHODOLOGY_SOURCE_PATH=private-sources/Tarasov_Iskusstvo-upravlencheskoy-borby.fb2
# Минимум 32 символа. Если пусто, используется ADMIN_SESSION_SECRET.
SITE_SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITOR_USER_CHAT_ID=376957179
TELEGRAM_WEEKLY_CHAT_ID=-1001732999759

# Необязательно. На Vercel Pro/Enterprise позволяют получать Usage через Billing API.
# На Hobby официальный API потребления недоступен — админ-панель покажет ссылку на кабинет Vercel.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
